# MongoDB Atlas — use the Mumbai (ap-south-1) cluster for low latency to Indore.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/clinic?retryWrites=true&w=majority"

# Razorpay. The secret is server-side only and must never reach the browser.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# MSG91 — transactional SMS. Sender ID and every template need TRAI DLT
# approval before these will send anything; that registration takes weeks.
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_OTP_TEMPLATE_ID=""
MSG91_TOKEN_TEMPLATE_ID=""

# Protects the Vercel Cron endpoints (lock expiry, payment reconciliation).
CRON_SECRET=""
